DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=appdb
DB_SSL=false
DB_MAX_POOL=5
DB_IDLE_TIMEOUT=10000
DB_CONNECT_TIMEOUT=5000
# HTTP server port (Node reads APP_PORT; docker compose maps host:container with the same value)
APP_PORT=8080

# For npm run migrate:* (node-pg-migrate CLI). Keep in sync with DB_* above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
